#!/usr/bin/env bash
# pulse-run — one pulse, run by launchd every 60s.
#
# Loads CELLS_PROXY_SECRET from ~/.cells/secrets.json, sets the env vars pi
# needs, isolates pulse's pi auth dir from mother's, then runs `pi -p /pulse`
# in print mode. Each invocation is a fresh process — nothing persists in
# memory across pulses; all state lives on disk under ~/.cells/.
set -euo pipefail

SECRETS="${HOME}/.cells/secrets.json"
if [[ ! -f "$SECRETS" ]]; then
  echo "pulse-run: missing $SECRETS" >&2
  exit 1
fi

# Pull CELLS_PROXY_SECRET. We use bun's JSON-aware shell instead of jq so
# pulse doesn't gain a system dep just to read one key.
SECRET="$(/usr/bin/env bun -e 'console.log(JSON.parse(require("fs").readFileSync(process.argv[1],"utf-8")).CELLS_PROXY_SECRET||"")' "$SECRETS")"
if [[ -z "$SECRET" ]]; then
  echo "pulse-run: CELLS_PROXY_SECRET not in $SECRETS" >&2
  exit 1
fi

# pi-ai's openai-codex provider reads OPENAI_CODEX_API_KEY as the bearer.
# heartbeat-watch and proxy reads use MOTHER_SECRET. They're the same shared
# secret on the cells side; pulse only needs the codex one for outbound LLM
# calls, but exporting both keeps parity with what mother does.
export OPENAI_CODEX_API_KEY="$SECRET"
export MOTHER_SECRET="$SECRET"

# Isolate pulse's pi auth from mother's. Without this, pi reads
# ~/.pi/agent/auth.json (mother's anthropic OAuth) and tries to use that
# bearer for codex requests, which 401s.
export PI_CODING_AGENT_DIR="${HOME}/.cells/pulse-agent"
mkdir -p "$PI_CODING_AGENT_DIR"

PULSE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PULSE_DIR"

# print mode + slash command. Stdout/stderr land in launchd's log paths.
exec pi -p "/pulse"
