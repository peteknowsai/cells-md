#!/usr/bin/env bash
# operator-run — long-lived operator process, launched by launchd.
#
# Loads CELLS_PROXY_SECRET, SLACK_APP_TOKEN, SLACK_BOT_TOKEN from
# ~/.cells/secrets.json, sets the env operator's pi extensions need,
# isolates pi's auth dir from mother's, then exec's pi.
#
# Operator is a single long-lived process (NOT print-mode-per-tick like
# pulse). The slack-adapter extension keeps the Socket Mode connection
# alive across pi turns and injects each inbound message as a new user
# message into pi's session. KeepAlive=true in the launchd plist
# restarts on crash; Socket Mode is at-most-once across reconnects in
# v1 (a known limitation, documented in docs/operator.md).
set -euo pipefail

SECRETS="${HOME}/.cells/secrets.json"
if [[ ! -f "$SECRETS" ]]; then
  echo "operator-run: missing $SECRETS" >&2
  exit 1
fi

# Read three keys in one bun call.
read CELLS_PROXY_SECRET SLACK_APP_TOKEN SLACK_BOT_TOKEN <<<"$(/usr/bin/env bun -e '
const s = JSON.parse(require("fs").readFileSync(process.argv[1], "utf-8"));
console.log([s.CELLS_PROXY_SECRET ?? "", s.SLACK_APP_TOKEN ?? "", s.SLACK_BOT_TOKEN ?? ""].join(" "));
' "$SECRETS")"

if [[ -z "$CELLS_PROXY_SECRET" ]]; then
  echo "operator-run: CELLS_PROXY_SECRET not in $SECRETS" >&2
  exit 1
fi
missing=()
[[ -z "$SLACK_APP_TOKEN" ]] && missing+=("SLACK_APP_TOKEN")
[[ -z "$SLACK_BOT_TOKEN" ]] && missing+=("SLACK_BOT_TOKEN")
if (( ${#missing[@]} > 0 )); then
  echo "operator-run: missing in $SECRETS: ${missing[*]} — see plan Phase A" >&2
  exit 1
fi

export OPENAI_CODEX_API_KEY="$CELLS_PROXY_SECRET"
export MOTHER_SECRET="$CELLS_PROXY_SECRET"
export SLACK_APP_TOKEN
export SLACK_BOT_TOKEN

# Isolate operator's pi auth from mother's. Without this, pi reads
# ~/.pi/agent/auth.json (mother's anthropic OAuth) and tries to use that
# bearer for codex, which 401s.
export PI_CODING_AGENT_DIR="${HOME}/.cells/operator-agent"
mkdir -p "$PI_CODING_AGENT_DIR"

OPERATOR_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$OPERATOR_DIR"

# Operator runs as a programmatic AgentSession (not the pi binary) so we
# own the session lifecycle and can drive turns from the Slack listener
# without the captured-pi-going-stale problem that hit interactive-mode
# extensions. See bin/operator.ts for the runtime.
exec /usr/bin/env bun "${OPERATOR_DIR}/bin/operator.ts"
