{
  "extensions": [
    ".pi/extensions/use-max/index.ts",
    ".pi/extensions/codex-proxy/index.ts",
    ".pi/extensions/memory/index.ts",
    ".pi/extensions/well-tools/index.ts",
    ".pi/extensions/mother-tools/index.ts",
    ".pi/extensions/mother-status/index.ts",
    ".pi/extensions/agent-debug/index.ts",
    ".pi/extensions/thinking/index.ts"
  ],
  "packages": [
    "npm:pi-web-access"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "openai/gpt-5.5-pro",
    "anthropic/claude-opus-4-7",
    "anthropic/claude-sonnet-4-6",
    "anthropic/claude-haiku-4-5"
  ],
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-4-7",
  "defaultThinkingLevel": "high",
  "modelChain": [
    "anthropic/claude-opus-4-7:high",
    "openai-codex/gpt-5.5:high"
  ],
  "harnessChain": [
    {
      "harness": "claude-code",
      "model": "anthropic/claude-opus-4-7",
      "thinking": "high"
    },
    {
      "harness": "pi",
      "model": "openai-codex/gpt-5.5",
      "thinking": "high"
    }
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "retry": {
    "provider": {
      "timeoutMs": 60000
    }
  }
}
