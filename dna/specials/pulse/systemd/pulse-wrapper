#!/bin/bash
# pulse-wrapper — paces the pulse cell's tick cadence by injecting a
# "run one pulse tick" message into its own main session every 5 minutes.
#
# Each tick rides the agent-comms fork path (the same rail `cells talk`
# uses peer-to-peer): the supervisor forks main read-only, runs the
# /pulse skill, persists state to disk, discards the fork. Main session
# never blocks — long ticks don't gate the next one, and concurrent ticks
# self-protect via pulse-core's 5-minute sentinel.
#
# The wrapper itself runs forever. systemd's pulse.service (Restart=always)
# brings it back on crash; the loop self-recovers from transient injection
# failures via the next tick. Installed at /usr/local/bin/pulse-wrapper by
# cells.ts:installPulseLoop.
set -uo pipefail

export HOME=/root
# shellcheck disable=SC1091
[ -f /etc/profile.d/cells-env.sh ] && . /etc/profile.d/cells-env.sh
export PATH="/root/bin:/root/.local/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"

# pulse-core resolves runtimeDir from homedir() (= /root/.cells) — the same
# default used everywhere else in the cell substrate. Logs land alongside.
LOG=/root/.cells/logs/pulse.log
TICK_INTERVAL="${PULSE_TICK_INTERVAL:-300}"

TICK_PROMPT='Run exactly one pulse tick now: read .claude/skills/pulse/SKILL.md and follow it start to finish, then stop. No narration.'

echo "[$(date -u +%FT%TZ)] pulse loop started (interval=${TICK_INTERVAL}s)" >>"$LOG"

# Self-name comes from CELL_NAME (baked into /etc/environment at birth).
# Falls back to "pulse" — the canonical name for this special.
CELL="${CELL_NAME:-pulse}"

# Fire-and-forget: the wrapper injects the tick message and returns
# immediately. The fork runs on its own (capped server-side by the
# adapter's forkAndAsk timeout — 300s for claude-code). The wrapper
# doesn't wait, doesn't care about the response — pulse work is
# observable via state files (pulse.json, pulse-cache/, log.md) and
# the cell's supervisor logs, not via the cells-talk reply.
while :; do
  start=$(date +%s)
  if /root/bin/cells talk "$CELL" "$TICK_PROMPT" >>"$LOG" 2>&1; then
    :
  else
    rc=$?
    echo "[$(date -u +%FT%TZ)] tick injection exited non-zero (rc=$rc)" >>"$LOG"
  fi
  # Sleep the remainder of the interval. The injection itself returns
  # in ~1s (just a POST), so this is effectively a fixed cadence.
  elapsed=$(( $(date +%s) - start ))
  remaining=$(( TICK_INTERVAL - elapsed ))
  if [ "$remaining" -gt 0 ]; then
    sleep "$remaining"
  fi
done
