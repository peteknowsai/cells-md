#!/bin/bash
# Wrapper for pulse.service — sources cells-env.sh so pi sees the auth
# env vars it expects. Installed at /usr/local/bin/pulse-pi-wrapper by
# cells.ts:installPulseTimer.
set -euo pipefail
# HOME must be set BEFORE sourcing cells-env.sh — the shim references
# $HOME (for PATH=$HOME/.bun/bin:…) and set -u trips on unbound vars
# when systemd invokes us with an empty environment.
export HOME=/root
# shellcheck disable=SC1091
[ -f /etc/profile.d/cells-env.sh ] && . /etc/profile.d/cells-env.sh
cd /root
exec /usr/bin/pi -p /pulse
