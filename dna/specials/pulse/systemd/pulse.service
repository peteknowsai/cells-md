[Unit]
Description=pulse — cells family scheduler (paces tick cadence via fork-injection)
After=network-online.target well-site.service
Wants=network-online.target well-site.service

[Service]
# Always-on agent loop, not a timer + oneshot — one long-lived unit
# whose job is to keep the pulse agent ticking. The loop body lives
# in pulse-wrapper.
Type=simple
WorkingDirectory=/root
EnvironmentFile=/etc/environment
ExecStartPre=/bin/mkdir -p /root/.cells/logs /root/.cells/pulse-inbox /root/.cells/state
ExecStart=/usr/local/bin/pulse-wrapper
# The wrapper is meant to run forever; if it ever falls over (OOM, a
# claude crash that takes the loop down, a reboot), bring it straight back.
Restart=always
RestartSec=10
StandardOutput=append:/root/.cells/logs/pulse.service.log
StandardError=append:/root/.cells/logs/pulse.service.log

[Install]
WantedBy=multi-user.target
