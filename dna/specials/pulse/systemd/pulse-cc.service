[Unit]
Description=pulse-cc — cells family scheduler (always-on claude-code agent loop)
After=network-online.target
Wants=network-online.target

[Service]
# Not a timer + oneshot (that is the pi-pulse shape). pulse-cc is an
# always-on agent loop: one long-lived unit whose job is to keep the
# pulse agent ticking. The loop body lives in pulse-cc-wrapper.
Type=simple
WorkingDirectory=/root
EnvironmentFile=/etc/environment
ExecStartPre=/bin/mkdir -p /var/cells/pulse/logs /var/cells/pulse/pulse-inbox /var/cells/pulse/state
ExecStart=/usr/local/bin/pulse-cc-wrapper
# The wrapper is meant to run forever; if it ever falls over (OOM, a
# claude crash that takes the loop down, a reboot), bring it straight back.
Restart=always
RestartSec=10
StandardOutput=append:/var/cells/pulse/logs/pulse-cc.service.log
StandardError=append:/var/cells/pulse/logs/pulse-cc.service.log

[Install]
WantedBy=multi-user.target
