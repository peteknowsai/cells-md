#!/usr/bin/env bun
/**
 * cells — slim in-cell CLI.
 *
 * Lets a cell see its peers, inspect itself, and talk to other cells. Read
 * + talk only — no create/destroy (those stay with the keeper on Pete's Mac;
 * the substrate API at 127.0.0.1:7878 isn't reachable from inside a cell).
 *
 * Read surface routes through the cells.md edge: `proxy.cells.md/peers`
 * (bearer = $CELLS_PROXY_SECRET), the same path `cells talk --list` uses.
 * The retired pre-wells Sprites API (api.sprites.dev / $SPRITES_TOKEN) is
 * gone — on a wells-era cell that token is absent, so the old read commands
 * died with a confusing "SPRITES_TOKEN not set" that read like an auth gap.
 */

function die(msg: string, code = 1): never {
  console.error(msg);
  process.exit(code);
}

function selfName(): string {
  // CELL_NAME is the canonical source. The supervisor and well-firstboot both
  // bake it in; the on-cell login env (bash -lc → /etc/profile.d) may not
  // surface it, so we fall back to /root/.pi/status.json's first channel
  // (#<cellname>) and finally to hostname. Hostname returns the well name
  // for hatched cells (e.g. egg-0f7d66), which is *not* the cell name.
  if (process.env.CELL_NAME) return process.env.CELL_NAME;
  try {
    const j = JSON.parse(Bun.spawnSync(["cat", "/root/.pi/status.json"]).stdout.toString());
    const first = Array.isArray(j?.channels) ? j.channels[0] : "";
    if (typeof first === "string" && first.startsWith("#")) return first.slice(1);
  } catch { /* fall through */ }
  return Bun.spawnSync(["hostname"]).stdout.toString().trim();
}

type Peer = {
  name: string;
  status: string;
  harness: string;
  model: string;
  special: boolean;
  site_url: string;
};

// The fleet roster, from the Mac's registry via the proxy edge. Bearer-auth'd
// with the same $CELLS_PROXY_SECRET the cell uses for `cells talk`. This is
// the live replacement for the retired Sprites read API.
async function fetchPeers(): Promise<Peer[]> {
  const secret = getProxySecret();
  const res = await fetch("https://proxy.cells.md/peers", {
    headers: { authorization: `Bearer ${secret}` },
  });
  if (!res.ok) {
    const body = await res.text();
    die(`peers lookup failed (${res.status}): ${body.slice(0, 300)}`);
  }
  const data = (await res.json()) as { peers: Peer[]; as_of: string };
  return data.peers ?? [];
}

// ───── commands ─────

async function cmdWhoami() {
  console.log(selfName());
}

function renderPeerRow(p: Peer): string {
  const marker = p.special ? "*" : " ";
  const status = p.status === "alive" ? "alive" : p.status;
  return `${marker} ${p.name.padEnd(22)} ${status.padEnd(10)} ${(p.harness ?? "").padEnd(12)} ${p.model ?? ""}`;
}

async function cmdList() {
  const peers = await fetchPeers();
  if (peers.length === 0) {
    console.log("(no peers)");
    return;
  }
  peers.sort((a, b) => a.name.localeCompare(b.name));
  for (const p of peers) console.log(renderPeerRow(p));
}

async function cmdInfo(arg: string) {
  const name = arg === "self" || arg === "" ? selfName() : arg;
  const peers = await fetchPeers();
  const p = peers.find((x) => x.name === name);
  if (!p) die(`no peer named '${name}' (try: cells list)`);
  // Egress/network-policy (the old Sprites `info` field) has no cells.md
  // equivalent — that's a Cloudflare/wells concern, not surfaced to a cell.
  console.log(`name:     ${p.name}`);
  console.log(`status:   ${p.status}`);
  console.log(`harness:  ${p.harness}`);
  console.log(`model:    ${p.model}`);
  console.log(`special:  ${p.special ? "yes" : "no"}`);
  console.log(`url:      ${p.site_url}`);
}

async function cmdCheckpoint(arg: string) {
  // Checkpoint is a substrate (wells) operation driven from the keeper's Mac.
  // A cell can't reach welld (127.0.0.1:7878 is Mac-local), and the Sprites
  // path that used to back this is retired — so there is no in-cell path.
  const name = arg === "self" || arg === "" ? selfName() : arg;
  die(
    `checkpoint is keeper-only — a cell can't reach the substrate from inside.\n` +
      `  Ask Pete to run \`cells checkpoint ${name}\` on the Mac, or \`cells talk mother\`.`,
  );
}

// `cells talk` — the agent-comms primitive (substrate-native cells-to-cells
// RPC). Sender constructs an envelope, POSTs it to the peer's per-cell
// Worker /inbox/append (kind:"agent"); the peer's supervisor forks its
// main session read-only, answers, and the response routes back via
// reply_to. With --await, the CLI blocks until the reply arrives (true
// RPC). Without, it returns immediately (fire-and-forget).
//
// Supersedes the sprites-era tmux-send-keys + sleep 8 implementation.
// That ran from cells-to-cells via the Sprites API; this runs over the
// public CF Worker per-cell, using the same path as Slack/email but with
// a different envelope kind.

import { makeOutgoing, type AgentTarget } from "/root/lib/agent-envelope";

type TalkOpts = {
  peer: string;
  message: string;
  wantsAwait: boolean;
  target: AgentTarget;
  session: string;       // named durable session, or "" for plain target routing
  thread: string;
  timeoutS: number;
};

function parseTimeout(s: string): number {
  const m = String(s).match(/^(\d+)\s*([smh]?)$/);
  if (!m) return 120;
  const n = Number(m[1] ?? 120);
  return m[2] === "h" ? n * 3600 : m[2] === "m" ? n * 60 : n;
}

function parseTalkArgs(rest: string[]): TalkOpts {
  let peer = "";
  let wantsAwait = false;
  let target: AgentTarget = "fork";
  let session = "";
  let thread = "";
  // 180s: must exceed the peer's forkAndAsk ceiling (pi: 150s) plus the
  // inbox→DO→WS→reply routing round-trips, or the CLI gives up before a
  // slow-but-healthy fork can answer.
  let timeoutS = 180;
  const positional: string[] = [];
  let i = 0;
  while (i < rest.length) {
    const a = rest[i] ?? "";
    if (a === "--await") { wantsAwait = true; i++; continue; }
    if (a === "--main") { target = "main"; i++; continue; }
    if (a.startsWith("--session=")) { session = a.slice("--session=".length); i++; continue; }
    if (a === "--session") { session = rest[++i] ?? ""; i++; continue; }
    if (a.startsWith("--thread=")) { thread = a.slice("--thread=".length); i++; continue; }
    if (a === "--thread") { thread = rest[++i] ?? ""; i++; continue; }
    if (a.startsWith("--timeout=")) { timeoutS = parseTimeout(a.slice("--timeout=".length)); i++; continue; }
    if (a === "--timeout") { timeoutS = parseTimeout(rest[++i] ?? "120s"); i++; continue; }
    positional.push(a);
    i++;
  }
  peer = positional[0] ?? "";
  const message = positional.slice(1).join(" ");
  // --session main/fork are aliases for the existing target routing; any other
  // name is a durable named session handled by the peer's interactive pool.
  if (session === "main") { target = "main"; session = ""; }
  else if (session === "fork") { target = "fork"; session = ""; }
  return { peer, message, wantsAwait, target, session, thread, timeoutS };
}

function getProxySecret(): string {
  const v = process.env.CELLS_PROXY_SECRET ?? "";
  if (!v) die("CELLS_PROXY_SECRET not set in env (sourced by /etc/profile.d/cells-env.sh)");
  return v;
}

// `cells verify` — fan-out a decision to N peers in parallel via cells talk,
// aggregate AGREE/DISAGREE stances. Killer-app pattern over the talk
// primitive: every Pete-affecting decision can be cross-checked against
// siblings on different models before committing.
async function cmdVerify(rest: string[]): Promise<void> {
  let decision = "";
  let context = "";
  let timeoutS = 90;
  const peers: string[] = [];
  for (let i = 0; i < rest.length; i++) {
    const a = rest[i] ?? "";
    if (a.startsWith("--to=")) { peers.push(...a.slice(5).split(",").map(s => s.trim()).filter(Boolean)); continue; }
    if (a === "--to") { const v = rest[++i] ?? ""; peers.push(...v.split(",").map(s => s.trim()).filter(Boolean)); continue; }
    if (a.startsWith("--context=")) { context = a.slice("--context=".length); continue; }
    if (a === "--context") { context = rest[++i] ?? ""; continue; }
    if (a.startsWith("--context-file=")) {
      const p = a.slice("--context-file=".length);
      try { context = await Bun.file(p).text(); }
      catch (e) { die(`--context-file: cannot read ${p}: ${(e as Error).message}`); }
      continue;
    }
    if (a.startsWith("--timeout=")) {
      const v = a.slice("--timeout=".length);
      const m = v.match(/^(\d+)\s*([smh]?)$/);
      timeoutS = m ? Number(m[1]) * (m[2] === "h" ? 3600 : m[2] === "m" ? 60 : 1) : 90;
      continue;
    }
    if (a.startsWith("-")) die(`unknown flag: ${a}`);
    decision = decision ? decision + " " + a : a;
  }
  const uniquePeers = Array.from(new Set(peers));
  if (!decision || uniquePeers.length === 0) {
    die("usage: cells verify \"<decision>\" --to=<cellA>[,<cellB>...] [--context=<text>] [--context-file=<path>] [--timeout=<Ns>]");
  }
  const promptLines: string[] = [
    "[PEER VERIFIER QUERY]",
    "Another cell is considering a decision and wants your take before acting.",
    "You're being consulted in a forked read-only branch — don't update your plans",
    "or memory based on this; just give your honest read using what you already know.",
    "",
  ];
  if (context.trim()) {
    promptLines.push("CALLER CONTEXT:");
    promptLines.push(context.trim());
    promptLines.push("");
  }
  promptLines.push("DECISION: " + decision);
  promptLines.push("");
  promptLines.push("Respond in this exact format (2-3 short sentences total):");
  promptLines.push("  AGREE or DISAGREE: <one word>");
  promptLines.push("  WHY: <1 sentence>");
  promptLines.push("  CONCERN: <flag any risk, or \"none\">");
  const prompt = promptLines.join("\n");
  // Parallel via Promise.all + Bun.spawn.
  const t0 = Date.now();
  const responses = await Promise.all(uniquePeers.map(async (peer) => {
    const proc = Bun.spawn(
      ["/root/bin/cells", "talk", peer, "--await", `--timeout=${timeoutS}s`, prompt],
      { stdin: "ignore", stdout: "pipe", stderr: "pipe" },
    );
    const [stdout, stderr] = await Promise.all([
      new Response(proc.stdout).text(),
      new Response(proc.stderr).text(),
    ]);
    const code = await proc.exited;
    return { peer, code, stdout: stdout.trim(), stderr: stderr.trim() };
  }));
  const dt = Date.now() - t0;

  let agree = 0, disagree = 0, unclear = 0;
  const takes: Array<{ peer: string; stance: string; ok: boolean; text: string; exit_code?: number; error?: string }> = [];
  console.log(`# cells verify · ${uniquePeers.length} peers · ${Math.round(dt / 100) / 10}s`);
  console.log(`# decision: ${decision}`);
  if (context) console.log(`# context: ${context.length > 80 ? context.slice(0, 77) + "..." : context}`);
  console.log("");
  for (const r of responses) {
    if (r.code !== 0) {
      console.log(`## ${r.peer} — ERROR`);
      console.log(`  exit ${r.code}: ${(r.stderr || r.stdout).slice(0, 240)}`);
      console.log("");
      unclear++;
      takes.push({ peer: r.peer, stance: "error", ok: false, text: r.stdout, exit_code: r.code, error: r.stderr });
      continue;
    }
    const head = r.stdout.slice(0, 200).toUpperCase();
    const stance = /\bDISAGREE\b/.test(head) ? "disagree" : /\bAGREE\b/.test(head) ? "agree" : "unclear";
    if (stance === "agree") agree++; else if (stance === "disagree") disagree++; else unclear++;
    const label = stance === "agree" ? "AGREE" : stance === "disagree" ? "DISAGREE" : "UNCLEAR";
    console.log(`## ${r.peer} — ${label}`);
    for (const line of r.stdout.split("\n")) console.log(`  ${line}`);
    console.log("");
    takes.push({ peer: r.peer, stance, ok: true, text: r.stdout });
  }
  const verdict =
    agree > 0 && disagree === 0 ? "CONSENSUS-AGREE" :
    disagree > 0 && agree === 0 ? "CONSENSUS-DISAGREE" :
    agree > 0 && disagree > 0 ? "SPLIT" :
    "UNCLEAR";
  console.log(`# verdict: ${verdict} (agree=${agree} disagree=${disagree} unclear=${unclear})`);
  // Best-effort append to /root/.cell/verify-log/<date>.jsonl so the cell
  // has a trail of "what did I cross-check, and what did the peers say?"
  try {
    const { appendFile, mkdir } = await import("node:fs/promises");
    const dir = "/root/.cell/verify-log";
    await mkdir(dir, { recursive: true });
    const date = new Date().toISOString().slice(0, 10);
    const file = `${dir}/${date}.jsonl`;
    const rec = { ts: new Date().toISOString(), from: selfName(), decision, context, peers: uniquePeers, takes, verdict, dt_ms: dt };
    await appendFile(file, JSON.stringify(rec) + "\n");
  } catch (e) {
    console.error(`# (log append failed: ${(e as Error).message})`);
  }
}

async function cmdTalkList(): Promise<void> {
  // Same roster as `cells list` — one row per peer from the cells.md edge.
  for (const p of await fetchPeers()) console.log(renderPeerRow(p));
}

async function cmdTalk(rest: string[]) {
  // --list short-circuits before envelope parsing — it has no peer/message.
  if (rest[0] === "--list" || rest.includes("--list")) {
    return cmdTalkList();
  }
  const { peer, message, wantsAwait, target, session, thread, timeoutS } = parseTalkArgs(rest);
  if (!peer || !message) {
    die("usage: cells talk <peer> [--await] [--main] [--session=<name>] [--thread=<id>] [--timeout=<Ns>] <message>\n  or: cells talk --list");
  }
  const self = selfName();
  const secret = getProxySecret();
  const replyTo = wantsAwait ? `https://${self}.cells.md/inbox/append` : "";
  const env = makeOutgoing({
    from: self,
    to: peer,
    text: message,
    target,
    session: session || undefined,
    thread_id: thread || undefined,
    reply_to: replyTo,
    timeout_seconds: wantsAwait ? timeoutS : undefined,
  });

  // POST envelope to peer's inbox/append. 202 means accepted; the supervisor
  // is now forking (or routing to main) and will reply asynchronously.
  //
  // Short timeout + retries, NOT one naked fetch: when this talk is the
  // thing that woke a hibernating well, the guest's outbound network can
  // silently stall for the first ~seconds-to-minutes after restore (SYNs
  // dropped, no RST). A naked fetch sat in that stall for Bun's 300s
  // default — the advisor's WhatsApp mutes on 2026-06-11 were exactly
  // this. Abort at 15s and retry; by the second or third attempt the
  // network has settled and the POST lands in milliseconds.
  // 5 × (15s abort + backoff) ≈ a 95s window — the observed post-restore
  // black-hole lasts ~60-70s, so the late attempts land on settled network.
  let postRes: Response | null = null;
  let lastErr: unknown = null;
  for (let attempt = 1; attempt <= 5; attempt++) {
    try {
      postRes = await fetch(`https://${peer}.cells.md/inbox/append`, {
        method: "POST",
        headers: {
          "content-type": "application/json",
          authorization: `Bearer ${secret}`,
        },
        body: JSON.stringify({ event: env }),
        signal: AbortSignal.timeout(15_000),
      });
      break;
    } catch (e) {
      lastErr = e;
      postRes = null;
      if (attempt < 5) await new Promise((r) => setTimeout(r, 2_000 * attempt));
    }
  }
  if (!postRes) {
    die(JSON.stringify({
      ok: false,
      command: "talk",
      error: `POST to ${peer} failed after 5 attempts: ${String(lastErr).slice(0, 150)}`,
      diagnosis: "peer inbox unreachable — network stall or worker down",
    }));
    return;
  }
  if (!postRes.ok) {
    const body = await postRes.text();
    die(`POST to ${peer} failed (${postRes.status}): ${body.slice(0, 300)}`);
  }

  if (!wantsAwait) {
    console.log(JSON.stringify({ ok: true, command: "talk", data: { corr_id: env.corr_id, sent_to: peer } }));
    return;
  }

  // --await: HTTP long-poll the local supervisor for the matching reply.
  // The supervisor holds the connection until DO forwards an agent_reply
  // with matching corr_id, or the timeout expires.
  const waitUrl = `http://localhost:8080/agent-wait?corr_id=${encodeURIComponent(env.corr_id)}&timeout=${timeoutS}`;
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), (timeoutS + 5) * 1000); // +5s buffer past server-side timeout
  try {
    const waitRes = await fetch(waitUrl, { signal: ctrl.signal });
    clearTimeout(timer);
    if (waitRes.status === 408) {
      die(JSON.stringify({ ok: false, command: "talk", error: "timeout", diagnosis: `no reply from ${peer} within ${timeoutS}s` }));
    }
    if (!waitRes.ok) {
      const body = await waitRes.text();
      die(JSON.stringify({ ok: false, command: "talk", error: `wait failed ${waitRes.status}`, diagnosis: body.slice(0, 200) }));
    }
    const reply = await waitRes.json() as { text?: string };
    console.log(reply?.text ?? "");
  } catch (e: any) {
    clearTimeout(timer);
    if (e?.name === "AbortError") {
      die(JSON.stringify({ ok: false, command: "talk", error: "timeout", diagnosis: "client-side timeout" }));
    }
    die(JSON.stringify({ ok: false, command: "talk", error: String(e).slice(0, 200) }));
  }
}

// ───── dispatch ─────

const [sub, ...rest] = process.argv.slice(2);

switch (sub) {
  case "whoami":
    await cmdWhoami();
    break;
  case "list":
  case "ls":
    await cmdList();
    break;
  case "info":
    await cmdInfo(rest[0] ?? "self");
    break;
  case "talk":
    await cmdTalk(rest);
    break;
  case "verify":
    await cmdVerify(rest);
    break;
  case "checkpoint":
    await cmdCheckpoint(rest[0] ?? "self");
    break;
  default:
    console.log("cells — in-cell CLI (read + talk subset)");
    console.log("");
    console.log("usage:");
    console.log("  cells whoami              print self name");
    console.log("  cells list                list peer cells (status, harness, model)");
    console.log("  cells info [name|self]    show name, status, harness, model, url (default: self)");
    console.log("  cells talk <peer> [flags] <msg>   send to a peer; --await blocks for reply, --main escalates to peer's main thread");
    console.log("  cells verify <decision> --to=<peers> fan out a decision to N peers, aggregate AGREE/DISAGREE");
    console.log("");
    console.log("not available in-cell (keeper-only, run on Pete's Mac):");
    console.log("  create, destroy, sleep, wake, checkpoint, dream");
    console.log("  (the substrate API isn't reachable from inside a cell \u2014 ask Pete or `cells talk mother`)");
    process.exit(sub ? 1 : 0);
}
